# =========================
# 🗄 DATABASE
# =========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=wisemonitor
DB_USER=wisemonitor
DB_PASSWORD=

# =========================
# 🔐 JWT
# =========================
JWT_SECRET=
JWT_ISSUER=WiseMonitorAuth
JWT_AUDIENCE=WiseMonitorUsers
JWT_EXPIRATION_MINUTES=3000

# =========================
# 🌐 APP
# =========================
APP_BASE_URL=http://localhost:8080

# =========================
# 📸 STORAGE
# =========================
SCREENSHOT_PATH=/app/storage/screenshots

# =========================
# 🚀 PORT
# =========================
APP_PORT=8080

# =========================
# 🔒 SEGURANÇA (Fase 1)
# =========================
# Origens do frontend autorizadas a chamar a API (separadas por vírgula)
ALLOWED_ORIGINS=https://app.wisemonitor.com

# Senha do SMTP (nunca deixe em appsettings.json)
SMTP_PASS=

# "true" para aplicar migrations automaticamente no startup (padrão: só em Development)
AUTO_MIGRATE=false

# Credenciais do SuperAdmin seed (opcional — senha só é usada na primeira execução)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# =========================
# 🎥 VIDEO SEGMENTS (Live)
# =========================
# Quantas horas de histórico de vídeo manter por dispositivo (mais antigo é apagado)
VIDEO_SEGMENT_RETENTION_HOURS=4

# Bucket compatível com S3 para os vídeos (Cloudflare R2, Backblaze B2, MinIO...).
# Com os quatro valores definidos, o agent envia o MP4 direto ao bucket por URL
# assinada (não passa pela API nem pelo Postgres) e o painel toca de lá. Faltando
# algum: o agent usa o upload antigo (multipart, gravado no banco).
# Cloudflare R2: endpoint https://<ACCOUNT_ID>.r2.cloudflarestorage.com e chaves de
# um token "R2 API" com permissão Object Read & Write só neste bucket.
# Crie uma regra de ciclo de vida no bucket (ex.: apagar após 1 dia) — a
# retenção acima só apaga os metadados no banco.
VIDEO_BUCKET=
VIDEO_STORAGE_ENDPOINT=
VIDEO_STORAGE_ACCESS_KEY=
VIDEO_STORAGE_SECRET_KEY=
# Opcional: região da assinatura ("auto" no R2)
VIDEO_STORAGE_REGION=auto

# "false" desliga no servidor os uploads antigos de vídeo / capturas de tela
# (respondem 204 sem ler o corpo). Ligados por padrão.
VIDEO_SEGMENTS_ENABLED=true
SCREENSHOTS_ENABLED=true
